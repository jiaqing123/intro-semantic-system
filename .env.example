# ============================================================
# .env.example —— 环境变量模板（提交到版本库，不含真实值）
#
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
#   Windows:     copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# 校验：docker compose config --quiet
# ============================================================

# 【必填】DeepSeek API 密钥，由 SemanticSystemConsole/AiApiOptions.cs 读取
DS_API_INTRO_AI=sk-your-real-key-here

# 【可选】日志级别（Information / Debug / Warning ...）
LOG_LEVEL=Information

# 【可选】运行环境（Development / Production）
DOTNET_ENVIRONMENT=Development

# 【可选】镜像仓库前缀与版本标签（生产部署时使用；前缀需带尾部斜杠）
# DOCKER_REGISTRY=registry.example.com/
# APP_VERSION=1.0.0

# 【可选】构建配置（Debug / Release）
# BUILD_CONFIGURATION=Release
